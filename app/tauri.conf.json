{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WestPlay",
  "version": "2.3.0-domestic.1",
  "identifier": "app.westplay",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build:release",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WestPlay",
        "width": 780,
        "height": 520,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "maximizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "WestPlay",
    "copyright": "Copyright © 2026 WestPlay. Licensed under the GPL-3.0-or-later.",
    "category": "Game",
    "shortDescription": "国内定制版 CarPlay for Euro Truck Simulator 2 and American Truck Simulator",
    "longDescription": "WestPlay 国内定制版 brings in-cabin maps, traffic lights, freight information, Apple Music, YouTube, Bilibili, NetEase Cloud Music, Ximalaya, Douyin, Hongguo and local playback to ETS2 and ATS. Online updates are disabled; install upgrades manually.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../ui/dist/": "ui/",
      "../target/release/westplay.dll": "westplay.dll"
    }
  },
  "plugins": {}
}
